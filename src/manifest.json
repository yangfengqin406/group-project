{
  "name": "校园生活广场",
  "appid": "",
  "description": "三人团队 uni-app 双端骨架",
  "versionName": "0.1.2",
  "versionCode": "102",
  "transformPx": false,
  "vueVersion": "3",
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "modules": {
      "Camera": {},
      "Audio": {}
    },
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "safearea": {
      "background": "#f5f5eb",
      "bottom": {
        "offset": "auto"
      }
    },
    "distribute": {
      "android": {
        "minSdkVersion": 23,
        "targetSdkVersion": 35,
        "abiFilters": [
          "arm64-v8a",
          "armeabi-v7a"
        ],
        "enableOAID": false,
        "permissionPhoneState": {
          "request": "none"
        },
        "permissionExternalStorage": {
          "request": "none"
        }
      },
      "ios": {
        "dSYMs": false,
        "privacyDescription": {
          "NSCameraUsageDescription": "拍摄你主动发布的闲置、失物照片或个人头像。",
          "NSPhotoLibraryUsageDescription": "选择你主动上传的物品、头像或原创宠物 PNG 图片。"
        }
      },
      "icons": {
        "android": {
          "hdpi": "static/app/icons/icon-72.png",
          "xhdpi": "static/app/icons/icon-96.png",
          "xxhdpi": "static/app/icons/icon-144.png",
          "xxxhdpi": "static/app/icons/icon-192.png"
        },
        "ios": {
          "appstore": "static/app/icons/icon-1024.png",
          "iphone": {
            "app@2x": "static/app/icons/icon-120.png",
            "app@3x": "static/app/icons/icon-180.png",
            "spotlight@2x": "static/app/icons/icon-80.png",
            "spotlight@3x": "static/app/icons/icon-120.png",
            "settings@2x": "static/app/icons/icon-58.png",
            "settings@3x": "static/app/icons/icon-87.png",
            "notification@2x": "static/app/icons/icon-40.png",
            "notification@3x": "static/app/icons/icon-60.png"
          },
          "ipad": {
            "app": "static/app/icons/icon-76.png",
            "app@2x": "static/app/icons/icon-152.png",
            "proapp@2x": "static/app/icons/icon-167.png",
            "spotlight": "static/app/icons/icon-40.png",
            "spotlight@2x": "static/app/icons/icon-80.png",
            "settings": "static/app/icons/icon-29.png",
            "settings@2x": "static/app/icons/icon-58.png",
            "notification": "static/app/icons/icon-20.png",
            "notification@2x": "static/app/icons/icon-40.png"
          }
        }
      }
    }
  },
  "uniStatistics": {
    "enable": false
  },
  "h5": {
    "router": {
      "mode": "hash"
    },
    "title": "校园生活广场"
  },
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": true
    },
    "usingComponents": true,
    "lazyCodeLoading": "requiredComponents"
  }
}
