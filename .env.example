# 默认本机演示；所有 VITE_ 变量会进入前端，禁止填写任何服务端密钥。
VITE_API_MODE=mock
# http 模式填写真实 RPC 前缀。npm run campus:local 已自带本机 SQLite 后端并使用同源 /api。
# 公网/微信正式环境仍需要 HTTPS，不能把本机 HTTP 当作公网部署。
VITE_API_BASE_URL=
# 独立斗地主真实访客服务；留空则明确未配置。npm run game:local会为H5使用同源/game。
# 微信调试需绝对服务地址并另验网络域名/真机，不在此提交个人服务配置。
VITE_GAME_BASE_URL=
# 微信模板 ID 是公开配置；授权和服务端发送需要后续接入。
VITE_WECHAT_TEMPLATE_IDS=
