# 默认本机演示；所有 VITE_ 变量会进入前端，禁止填写任何服务端密钥。
VITE_API_MODE=mock
# http 模式填写真实 RPC 前缀。npm run campus:local 已自带本机 SQLite 后端并使用同源 /api。
# 公网/微信正式环境仍需要 HTTPS，不能把本机 HTTP 当作公网部署。
VITE_API_BASE_URL=
# 独立斗地主真实访客服务；留空则明确未配置。npm run game:local会为H5使用同源/game。
# 微信调试需绝对服务地址并另验网络域名/真机，不在此提交个人服务配置。
VITE_GAME_BASE_URL=
# 微信模板 ID 是公开配置；授权和服务端发送需要后续接入。
VITE_WECHAT_TEMPLATE_IDS=

# App 构建使用当前终端的环境变量；具体 PowerShell 命令见 docs/app-release-2026-10-27.md。
# HTTPS 服务源，不含 /api、路径或凭据。真实地址及 DCloud AppID 只放本机私有配置。
CAMPUS_APP_ORIGIN=
CAMPUS_DCLOUD_APP_ID=
# 正式发布会校验 AppID、HTTPS、公开联系邮箱及隐私政策地址；不代表平台审核通过。
CAMPUS_APP_RELEASE=false
VITE_APP_CONTACT_EMAIL=
VITE_APP_PRIVACY_URL=
